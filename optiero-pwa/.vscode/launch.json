{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug (pnpm)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "env": {
        "NODE_OPTIONS": "--inspect"          // ✅ correct way to attach debugger
      },
      "autoAttachChildProcesses": true
    },
    {
      "name": "Next.js: Attach",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ]
}
